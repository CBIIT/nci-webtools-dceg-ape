NODE_ENV=development

# AWS region/credentials (optional)
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

APP_BASE_URL=http://localhost/
API_BASE_URL=http://localhost:9000/

# Basic app/logging configuration
APP_NAME=ape-backend
APP_PORT=9000
APP_TIER=dev
LOG_LEVEL=debug

# App folders
DATA_FOLDER=../data
INPUT_FOLDER=../data/input
OUTPUT_FOLDER=../data/output

# Email/SMTP configuration
EMAIL_ADMIN=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=

# VPC configuration
VPC_ID=none
SUBNET_IDS=none
SECURITY_GROUP_IDS=none

# ECS cluster/worker task family name
ECS_CLUSTER=none
WORKER_TASK_NAME=none
WORKER_TYPE=local


SESSION_SECRET=your-secret-key-here
SESSION_MAX_AGE=86400000
DYNAMODB_SESSION_TABLE=sessions

# OIDC configuration
OIDC_BASE_URL=https://your-oidc-provider.com
OIDC_CLIENT_ID=your-client-id
OIDC_CLIENT_SECRET=your-client-secret
OIDC_CALLBACK_URI=http://localhost:3000/api/login
OIDC_ACR_VALUES=
